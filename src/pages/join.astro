---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { url } from '../lib/url';

const links = site.links;
const wechatOfficial = links.wechatOfficial;
const wechatGroup = links.wechatGroup;
const email = links.email;
const github = links.github;
const criteria = site.joinCriteria;
const formats = site.activityFormats;
---

<Base
  title="加入社区"
  description="加入 ROS Guangzhou（ROS 广州）：面向 ROS / ROS 2 开发者、机器人算法工程师、自动驾驶工程师、AI 感知研究者、创业者与高校学生的开放技术社区。"
>
  <div class="page-head">
    <h1>加入社区</h1>
    <p>如果你正在做机器人相关的事，或对此充满兴趣——欢迎加入 ROS Guangzhou，一起构建一个真正属于机器人开发者的城市社区。</p>
  </div>

  <h2>如果你是这样的人</h2>
  <ul class="plain-list">
    {criteria.map((c) => (<li><div class="title">{c}</div></li>))}
  </ul>

  <h2>入群与关注渠道</h2>
  <div class="grid">
    <div class="card">
      <h3>公众号：{wechatOfficial.label}</h3>
      <p>{wechatOfficial.note}</p>
      {
        wechatOfficial.qrImage ? (
          <p style="margin-top:.9rem">
            <span class="qr">
              <img src={url(wechatOfficial.qrImage)} alt={`${wechatOfficial.label} 二维码`} loading="lazy" />
            </span>
          </p>
        ) : (
          <p class="muted" style="margin-top:.7rem">二维码待补充。</p>
        )
      }
    </div>

    <div class="card">
      <h3>微信群</h3>
      <p>{wechatGroup.note}</p>
      {
        wechatGroup.qrImage ? (
          <p style="margin-top:.9rem">
            <span class="qr">
              <img src={url(wechatGroup.qrImage)} alt="微信群二维码" loading="lazy" />
            </span>
          </p>
        ) : (
          null
        )
      }
    </div>
  </div>

  <h2>其他联络方式</h2>
  <ul class="plain-list">
    <li>
      <div class="title">联络邮箱</div>
      <div class="desc">
        {email.url ? <a href={email.url}>{email.label}</a> : '待启用（建议使用域名邮箱，如 hello@rosgz.org）。'}
      </div>
    </li>
    <li>
      <div class="title">代码与内容仓库</div>
      <div class="desc">
        {github.url ? <a href={github.url}>{github.url}</a> : '待确定仓库归属后填入（站点已开源，接受内容勘误 PR）。'}
      </div>
    </li>
  </ul>

  <h2>可以怎么参与</h2>
  <ul class="plain-list">
    {
      formats.map((f) => (
        <li>
          <div class="title">{f.title}</div>
          <div class="desc">{f.desc}</div>
        </li>
      ))
    }
    <li>
      <div class="title">参与开源协作</div>
      <div class="desc">{site.openSourceFocus.join('、')}——欢迎带着项目来，或者从给别人提第一个 PR 开始。</div>
    </li>
    <li>
      <div class="title">做志愿者</div>
      <div class="desc">
        场地联络、活动记录（拍照/纪要）、内容整理（把分享整理成可复现文档）、站点维护，都需要人手。
      </div>
    </li>
  </ul>

  <div class="notice">
    <strong>隐私说明：</strong>本站为纯静态页面，不收集、不存储任何个人信息，也不使用第三方追踪统计。
    活动报名通过第三方表单进行，提交前请阅读该表单的隐私说明。
    参与社区活动请先阅读 <a href={url('/code-of-conduct')}>社区行为准则</a>。
  </div>
</Base>
