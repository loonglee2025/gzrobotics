---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.en.json';
import index from '../../data/weekly-index.json';
import { url } from '../../lib/url';

const digests = site.weeklyDigests;
const sourceMeta = (index.sources || []).filter((s) => s.id);
const syncedAt = index.syncedAt ? index.syncedAt.slice(0, 10) : '';
const totalIssues = sourceMeta.reduce((n, s) => n + (s.count || 0), 0);
const latestDates = sourceMeta.map((s) => s.latest).filter(Boolean).sort();
const latestOverall = latestDates[latestDates.length - 1] || '';
---

<Base
  title="Weekly Digests"
  description="ROS 2 weekly digest and robotics research weekly — tracking upstream changes, release cadence and new papers."
>
  <div class="page-head">
    <h1>Weekly Digests</h1>
    <p>
      Two continuously updated public digests. Everything is archived as Markdown in GitHub repositories,
      free to cite and to correct. Recent issues are also aggregated on this site.
    </p>
  </div>

  <div class="grid">
    {
      digests.map((d) => {
        const meta = sourceMeta.find((s) => s.id === d.id);
        return (
          <div class="card">
            <h3>{d.label}</h3>
            <p>{d.cadence}</p>
            <span class="meta">
              {meta ? `Latest issue ${meta.latest} · ${meta.count} issues on site` : 'Synced from GitHub'}
              <br />
              <a href={d.repo}>Read in the repository →</a>
            </span>
          </div>
        );
      })
    }
  </div>

  <div class="notice">
    <strong>Sync status:</strong> {totalIssues} issues are aggregated on this site,
    content updated through {latestOverall || syncedAt || 'not yet synced'}. The digest text is
    written in Chinese, so the in-site reader is the Chinese page — open
    <a href={url('/weekly')}> 技术周报</a> to read issues. Nothing is rewritten: the site mirrors the
    Markdown in each repository.
  </div>

  <h2>Editorial rules</h2>
  <ul class="plain-list">
    <li>
      <div class="title">Only verifiable sources</div>
      <div class="desc">
        Issues carry footnotes pointing to official docs, upstream PRs/discussions and original papers.
        No "someone said" claims.
      </div>
    </li>
    <li>
      <div class="title">Separate facts from judgement</div>
      <div class="desc">
        Upstream changes and release dates are facts; trend calls are explicitly marked as opinion.
      </div>
    </li>
    <li>
      <div class="title">Corrections via PR</div>
      <div class="desc">The repositories accept any correction or addition — just attach the source.</div>
    </li>
  </ul>
</Base>
