---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import eventsData from '../data/events.json';

const events = eventsData.events ?? [];
const upcoming = events.filter((e) => e.status === 'upcoming');
const latestEvent = upcoming[0];
const areas = site.technologyAreas;
const values = site.manifesto.values;
const formats = site.activityFormats;
---

<Base>
  <section class="hero">
    <p class="muted" style="margin:0;font-family:var(--mono);font-size:.82rem;letter-spacing:.1em">
      ROS GUANGZHOU · 广州机器人开发者社区
    </p>
    <h1>连接广州的<span class="accent">机器人开发者</span></h1>
    <p class="lead">
      面向机器人开发者的开放技术社区：以 ROS / ROS 2 为技术基础，连接在广州及周边从事机器人、自动驾驶、
      AI 感知、具身智能的开发者、研究者与创业者——通过线上交流与线下活动，推动技术分享、开源协作与工程实践。
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/join">加入社区</a>
      <a class="btn btn-ghost" href="/manifesto">读社区宣言</a>
      <a class="btn btn-ghost" href="/weekly">技术周报</a>
    </div>
  </section>

  <h2>社区关注的技术方向</h2>
  <div class="grid">
    {
      areas.map((area) => (
        <div class="card">
          <h3>{area.title}</h3>
          <div class="tags" style="margin-top:.5rem">
            {area.items.map((it) => (
              <span class="tag">{it}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  {
    latestEvent && (
      <section>
        <h2>下一次活动</h2>
        <div class="event">
          <div class="date">{latestEvent.date}</div>
          <div>
            <div style="font-weight:600">{latestEvent.title}</div>
            <p class="muted" style="margin:.3rem 0 0;font-size:.93rem">{latestEvent.summary}</p>
            {latestEvent.signupUrl && (
              <p style="margin:.6rem 0 0">
                <a class="btn btn-primary" href={latestEvent.signupUrl}>报名</a>
              </p>
            )}
          </div>
        </div>
      </section>
    )
  }

  <h2>我们相信</h2>
  <p class="muted" style="max-width:62ch">{site.manifesto.belief}</p>
  <div class="grid">
    {
      values.map((v) => (
        <div class="card">
          <h3>{v.title}</h3>
          <p>{v.desc}</p>
        </div>
      ))
    }
  </div>
  <p style="margin-top:1rem">
    <a href="/manifesto">完整社区宣言 →</a>
  </p>

  <h2>社区活动形式</h2>
  <ul class="plain-list">
    {
      formats.map((f) => (
        <li>
          <div class="title">{f.title}</div>
          <div class="desc">{f.desc}</div>
        </li>
      ))
    }
  </ul>

  <h2>这里适合谁</h2>
  <div class="tags" style="gap:.5rem">
    {site.memberProfiles.map((p) => <span class="tag">{p}</span>)}
  </div>
  <p class="muted" style="margin-top:.9rem">
    无论是刚入门的开发者，还是多年经验的工程师，都欢迎加入社区。
  </p>

  <div class="notice">
    <strong>关于本社区的身份：</strong>ROS Guangzhou 是由开发者自发组织的<strong>开放技术社区</strong>，
    与 Open Robotics / OSRF 无隶属关系，也不以任何官方名义活动。
    {site.principle}
  </div>
</Base>
