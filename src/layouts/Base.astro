---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/global.css';
import { url, basePath } from '../lib/url';

const { title, description } = Astro.props;
const desc = description || site.description;
const pageTitle = title
  ? `${title} · ${site.nameZh}（${site.name}）`
  : `${site.nameZh}（${site.name}）— ${site.tagline}`;

// 预览部署（GitHub Pages 子路径）时：canonical 仍指向正式域，并加 noindex，
// 避免预览站被搜索引擎当成重复内容收录。
const isPreview = basePath !== '';
const pathNoBase =
  isPreview && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname;
const canonical = new URL(pathNoBase, site.domain);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#0a1220" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ROSGZ" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主内容</a>
    <Header />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
