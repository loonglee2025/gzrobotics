---
import { url } from '../lib/url';
import { stripBase, langOf, withoutLocale, localePath } from '../lib/i18n';

const pathNoBase = stripBase(Astro.url.pathname);
const lang = langOf(pathNoBase);
const plain = withoutLocale(pathNoBase);

const navByLang = {
  zh: [
    { path: '/', label: '首页' },
    { path: '/about', label: '关于' },
    { path: '/manifesto', label: '宣言' },
    { path: '/events', label: '活动' },
    { path: '/weekly', label: '周报' },
    { path: '/resources', label: '资源' },
    { path: '/join', label: '加入' },
  ],
  en: [
    { path: '/', label: 'Home' },
    { path: '/about', label: 'About' },
    { path: '/manifesto', label: 'Manifesto' },
    { path: '/events', label: 'Events' },
    { path: '/weekly', label: 'Weekly' },
    { path: '/resources', label: 'Resources' },
    { path: '/join', label: 'Join' },
  ],
};

const nav = navByLang[lang];
const isActive = (item) => (item.path === '/' ? plain === '/' : plain.startsWith(item.path));

const otherLang = lang === 'zh' ? 'en' : 'zh';
const switchHref = url(localePath(otherLang, plain));
const switchLabel = lang === 'zh' ? 'EN' : '中文';
const switchTitle = lang === 'zh' ? 'Switch to English' : '切换到中文';
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={url(localePath(lang, '/'))}>
      <span class="mark">ROSGZ</span>
      <span class="zh">{lang === 'zh' ? 'ROS 广州' : 'Guangzhou'}</span>
    </a>
    <nav class="nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
      {
        nav.map((item) => (
          <a href={url(localePath(lang, item.path))} aria-current={isActive(item) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="lang-switch" href={switchHref} hreflang={otherLang} lang={otherLang} title={switchTitle}>
        {switchLabel}
      </a>
    </nav>
  </div>
</header>
